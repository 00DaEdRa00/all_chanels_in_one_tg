# Telegram API Credentials (from https://my.telegram.org)
API_ID=12345678
API_HASH=abcdef0123456789abcdef0123456789

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# Optional: Telethon StringSession for headless/cloud deployments
# If left blank, local .session files (user_collector.session) will be used
USER_SESSION_STRING=

# Database configuration
DB_PATH=feed_bot.db

# Admin Telegram User ID for update controls (/update, /check_updates)
ADMIN_ID=123456789

# Auto-update settings (for 24/7 server deployments)
# Set to true for automated git pull & reboot when new commits land in main
AUTO_UPDATE_CODE=false
CODE_CHECK_INTERVAL_HOURS=6
FOLDER_CHECK_INTERVAL_HOURS=12

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
